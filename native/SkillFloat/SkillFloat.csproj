<Project ToolsVersion="Current" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <RootNamespace>SkillFloat</RootNamespace>
    <AssemblyName>SkillFloat</AssemblyName>
    <ApplicationIcon>..\..\src-tauri\icons\icon.ico</ApplicationIcon>
    <LangVersion>latest</LangVersion>
    <PlatformTarget>x64</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <Deterministic>true</Deterministic>
    <DebugType>portable</DebugType>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <ApplicationManifest>app.manifest</ApplicationManifest>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Configuration)' == 'Release'">
    <Optimize>true</Optimize>
    <DebugSymbols>false</DebugSymbols>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Net.Http" />
    <Reference Include="System.Security" />
    <Reference Include="System.Web.Extensions" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="Program.cs" />
    <Compile Include="Models.cs" />
    <Compile Include="Storage.cs" />
    <Compile Include="NativeMethods.cs" />
    <Compile Include="SkillDiscovery.cs" />
    <Compile Include="UsageScanner.cs" />
    <Compile Include="AiService.cs" />
    <Compile Include="Theme.cs" />
    <Compile Include="MainForm.cs" />
    <Compile Include="EditorForm.cs" />
    <Compile Include="TranslationForm.cs" />
    <Compile Include="UsageForm.cs" />
    <Compile Include="Properties\AssemblyInfo.cs" />
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
